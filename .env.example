# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/SECURITY.md.

# Drizzle Kit / the app's own Postgres client. Use the Session Pooler
# connection string (not the direct db.<ref>.supabase.co host) — the direct
# host is IPv6-only on most Supabase plans, which breaks from most local
# networks and from Vercel's build environment.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public Supabase project values — not secret, but still not a real value here.
# Find them in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# This app's own base URL. Passed as emailRedirectTo to Supabase's
# signInWithOtp call — Supabase still expects it to be a configured
# Redirect URL (Dashboard → Authentication → URL Configuration) for the
# API call to succeed, even though the magic-link email itself now links
# directly via {{ .SiteURL }} in the custom email template rather than
# through Supabase's own /verify + redirect_to. See docs/LEARNED.md,
# 2026-08-10, for why: email security scanners were silently consuming
# the one-time token before the user could click it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1c — inbox connections. Not yet read by an OAuth route (that's a
# follow-up pass, once these credentials exist) but the encryption key IS
# already read by providers/crypto.ts, which the email_accounts schema
# depends on. Generate a Google OAuth client: console.cloud.google.com →
# OAuth consent screen (External, add yourself as a test user, no
# verification review needed for one user) → Credentials → OAuth client ID
# → "Web application" → Authorized redirect URI
# http://localhost:3000/api/auth/google/callback. Scope requested is
# read-only (gmail.readonly) — see docs/SECURITY.md.
GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# 32 bytes, base64-encoded — generate with `openssl rand -base64 32`.
# Encrypts OAuth tokens at rest (AES-256-GCM, providers/crypto.ts) before
# they're written to email_accounts. Never commit a real value. Rotation
# story still an open question — see docs/MEMORY.md.
TOKEN_ENCRYPTION_KEY=<32-byte-base64-key>

# Complete through Phase 1c's schema/encryption stage — this is every
# variable the codebase currently reads from process.env, not a partial
# list. Still to come: Microsoft OAuth client credentials (1c), an
# Anthropic API key (1d, email classification). Added here when the code
# that reads them exists — not before, per docs/CLAUDE.md: "Don't
# scaffold future-phase features."

# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/SECURITY.md.

# Drizzle Kit / the app's own Postgres client. Use the Session Pooler
# connection string (not the direct db.<ref>.supabase.co host) — the direct
# host is IPv6-only on most Supabase plans, which breaks from most local
# networks and from Vercel's build environment.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public Supabase project values — not secret, but still not a real value here.
# Find them in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# This app's own base URL. Passed as emailRedirectTo to Supabase's
# signInWithOtp call — Supabase still expects it to be a configured
# Redirect URL (Dashboard → Authentication → URL Configuration) for the
# API call to succeed, even though the magic-link email itself now links
# directly via {{ .SiteURL }} in the custom email template rather than
# through Supabase's own /verify + redirect_to. See docs/LEARNED.md,
# 2026-08-10, for why: email security scanners were silently consuming
# the one-time token before the user could click it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1c — inbox connections. Not yet read by an OAuth route (that's a
# follow-up pass, once these credentials exist) but the encryption key IS
# already read by providers/crypto.ts, which the email_accounts schema
# depends on. Generate a Google OAuth client: console.cloud.google.com →
# OAuth consent screen (External, add yourself as a test user, no
# verification review needed for one user) → Credentials → OAuth client ID
# → "Web application" → Authorized redirect URI
# http://localhost:3000/api/auth/google/callback. Scope requested is
# read-only (gmail.readonly) — see docs/SECURITY.md.
GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# 32 bytes, base64-encoded — generate with `openssl rand -base64 32`.
# Encrypts OAuth tokens at rest (AES-256-GCM, providers/crypto.ts) before
# they're written to email_accounts. Never commit a real value. Rotation
# story still an open question — see docs/MEMORY.md.
TOKEN_ENCRYPTION_KEY=<32-byte-base64-key>

# Phase 5 — Watchlist price checks. SerpApi's Google Shopping engine
# (docs/DECISIONS.md). Originally set up in Phase 3 for a per-item
# Walmart price-check that's since been retired in favor of the
# Watchlist — same account/key, just a different engine now. Free tier:
# 250 searches/month, 50/hour — every call corresponds to one explicit,
# user-triggered "check this item's price" click, never automatic or
# bulk. Sign up at serpapi.com.
SERPAPI_API_KEY=<serpapi-api-key>

# Phase 4 — /trips' store hours and route durations. A Google Maps
# Platform API key restricted to the Routes API and the Places API (New).
# Requires a Google Cloud billing account (a card on file) even within
# the free tier (10,000 events/month per API — far more than a
# single-user app will ever use, so real cost risk is ~$0). Set up at
# console.cloud.google.com → APIs & Services → enable "Routes API" and
# "Places API (New)" → Credentials → Create API key → restrict it to
# those two APIs. See docs/DECISIONS.md's Phase 4 ADR.
GOOGLE_MAPS_API_KEY=<google-maps-platform-api-key>

# Phase 1d — email classification/extraction. Gemini via Google AI
# Studio, not Claude (docs/DECISIONS.md's Phase 1d ADR) — a genuine free
# tier, no billing required. Sign up at aistudio.google.com → Get API key
# → Create API key. Note: free-tier inputs/outputs may be used by Google
# to improve their models — a disclosed tradeoff, revisit after the
# development phase.
GEMINI_API_KEY=<google-ai-studio-api-key>

# Phase 1d — protects /api/cron/sync (real Gmail reads + Gemini calls
# across every connected account) from being triggered by an arbitrary
# public request. Generate any random string, e.g. `openssl rand -hex 32`.
# Not wired to an actual Vercel Cron schedule yet — see docs/PHASES.md.
CRON_SECRET=<random-secret>

# Complete through Phase 1d — this is every variable the codebase
# currently reads from process.env, not a partial list. Still to come:
# Microsoft OAuth client credentials (1c). Added here when the code that
# reads them exists — not before, per docs/CLAUDE.md: "Don't scaffold
# future-phase features."
